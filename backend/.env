PORT=5000
NODE_ENV=development
JWT_SECRET=hackarena-secret-key-change-in-production
JWT_REFRESH_SECRET=hackarena-refresh-secret-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# IMPORTANT: Replace with your MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/hackarena?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hackarena

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173